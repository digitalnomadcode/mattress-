# Populate locally or in environment settings. Never commit real credentials.
# PostgreSQL connection for the running app. Separate dev/preview/production DBs.
DATABASE_URL=
# Optional dedicated shop database if an integration owns DATABASE_URL.
# Never set a production override in the local integration-test environment.
VELORA_DATABASE_URL=
# Direct PostgreSQL connection for deployment migrations, if different.
DIRECT_DATABASE_URL=
# Long random signing secret; set once in protected settings.
AUTH_SECRET=
# Exact public origin, e.g. http://localhost:3000 for local development.
# Used for authentication callbacks and mutating-request origin checks.
NEXTAUTH_URL=
# Initial owner bootstrap only. Never send the password in chat or commit it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Local Docker PostgreSQL only; setup:local generates this automatically.
DB_LOCAL_PASSWORD=
