{
  "name": "mattress-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:cutaway": "node scripts/cutaway-smoke.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "setup:local": "node scripts/setup-local.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx --test --experimental-test-isolation=none tests/integration/*.test.ts",
    "test:store": "node --env-file-if-exists=.env.local --import tsx scripts/store-e2e.ts",
    "release:check": "node --import tsx scripts/check-release.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "playwright": "1.62.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
