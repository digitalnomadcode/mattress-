generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  WAREHOUSE
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  DELIVERED
  CANCELLED
}

enum StockMovementType {
  OPENING
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  ALLOCATION
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum StockCountStatus {
  DRAFT
  COMPLETED
}

model Product {
  id           String               @id @default(cuid())
  model        String               @unique
  name         String
  features     Json?
  hardness     String?
  maximumLoadKg Int?
  manufacturer String?
  country      String?
  warrantyMonths Int?
  brand        String               @default("Велора")
  published    Boolean              @default(false)
  translations ProductTranslation[]
  variants     ProductVariant[]
  images       ProductImage[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ProductTranslation {
  productId   String
  locale      String
  title       String
  description String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altRu     String
  altKk     String
  kind      String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id            String             @id @default(cuid())
  sku           String             @unique
  productId     String
  widthCm       Int
  lengthCm      Int
  heightCm      Int?
  priceKzt      Int?
  active        Boolean            @default(true)
  product       Product            @relation(fields: [productId], references: [id])
  balance       InventoryBalance?
  movements     StockMovement[]
  orderItems    OrderItem[]
  reservations  StockReservation[]
  countLines    StockCountLine[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([productId, widthCm, lengthCm])
}

// One warehouse for this project. Add warehouseId when a second is required.
// Stage-two SQL must add CHECK(onHand >= reserved AND reserved >= 0).
model InventoryBalance {
  variantId String         @id
  onHand    Int            @default(0)
  reserved  Int            @default(0)
  version   Int            @default(0)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  updatedAt DateTime       @updatedAt
}

// Separate from sellable variants: never fabricate a model for the 10 items.
model UnallocatedStock {
  id             String          @id @default(cuid())
  reference      String          @unique
  widthCm        Int
  lengthCm       Int
  quantity       Int
  candidateModels String[]
  note           String
  movements      StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Append-only journal. Allocation writes paired signed movements in one tx.
// SQL checks in stage two: exactly one target (variantId or unallocatedStockId),
// quantityDelta != 0, and sign rules by movement type.
model StockMovement {
  id                 String            @id @default(cuid())
  operationKey       String            @unique
  variantId          String?
  unallocatedStockId String?
  type               StockMovementType
  quantityDelta      Int
  unitPriceKzt       Int?
  relatedMovementId  String?
  originalMovement   StockMovement? @relation("MovementReturns", fields: [relatedMovementId], references: [id], onDelete: Restrict)
  returns            StockMovement[] @relation("MovementReturns")
  orderItemId        String?
  actorId            String?
  reason             String
  occurredAt         DateTime?
  createdAt          DateTime          @default(now())
  variant            ProductVariant?   @relation(fields: [variantId], references: [id])
  unallocatedStock   UnallocatedStock? @relation(fields: [unallocatedStockId], references: [id])
  orderItem          OrderItem?        @relation(fields: [orderItemId], references: [id])
  actor              AdminUser?       @relation(fields: [actorId], references: [id])

  @@index([variantId, createdAt])
  @@index([orderItemId])
}

model WarehouseZone {
  id       String           @id @default(cuid())
  code     String           @unique
  nameRu   String
  nameKk   String
  counts   StockCountZone[]
}

model StockCount {
  id                 String           @id @default(cuid())
  reference          String           @unique
  status             StockCountStatus @default(DRAFT)
  accountingSnapshot Int
  countedAt          DateTime?
  createdAt          DateTime         @default(now())
  completedAt        DateTime?
  actorId            String?
  actor              AdminUser?       @relation(fields: [actorId], references: [id])
  zones              StockCountZone[]
  lines              StockCountLine[]
}

// Zone totals can be captured without inventing model allocations per zone.
model StockCountZone {
  countId  String
  zoneId   String
  quantity Int
  count    StockCount    @relation(fields: [countId], references: [id])
  zone     WarehouseZone @relation(fields: [zoneId], references: [id])

  @@id([countId, zoneId])
}

model StockCountLine {
  countId            String
  variantId          String
  expectedQuantity   Int
  actualQuantity     Int
  count              StockCount     @relation(fields: [countId], references: [id])
  variant            ProductVariant @relation(fields: [variantId], references: [id])

  @@id([countId, variantId])
}

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id               String        @id @default(cuid())
  number           Int           @unique @default(autoincrement())
  submissionKey    String        @unique
  customerId       String
  customerName     String
  customerPhone    String
  status           OrderStatus   @default(NEW)
  deliveryMethod   String
  deliveryAddress  String?
  deliveryFeeKzt   Int?
  note             String?
  version          Int           @default(0)
  customer         Customer      @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  events           OrderEvent[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deliveredAt      DateTime?

  @@index([status, createdAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  variantId    String
  skuSnapshot  String
  titleSnapshot String
  unitPriceKzt Int
  quantity     Int
  order        Order           @relation(fields: [orderId], references: [id])
  variant      ProductVariant  @relation(fields: [variantId], references: [id])
  reservation  StockReservation?
  movements    StockMovement[]

  @@unique([orderId, variantId])
}

model StockReservation {
  id          String            @id @default(cuid())
  orderItemId String            @unique
  variantId   String
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  item        OrderItem         @relation(fields: [orderItemId], references: [id])
  variant     ProductVariant    @relation(fields: [variantId], references: [id])

  @@index([variantId, status])
}

model OrderEvent {
  id           String       @id @default(cuid())
  operationKey String       @unique
  orderId      String
  fromStatus   OrderStatus
  toStatus     OrderStatus
  actorId      String
  createdAt    DateTime     @default(now())
  order        Order        @relation(fields: [orderId], references: [id])
  actor        AdminUser    @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
}

model AdminUser {
  id         String          @id @default(cuid())
  email      String          @unique
  name       String?
  role       Role            @default(WAREHOUSE)
  disabled   Boolean         @default(false)
  passwordHash String?
  sessionVersion Int         @default(0)
  movements  StockMovement[]
  counts     StockCount[]
  events     OrderEvent[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// No credentials in this table. Payment/WhatsApp API secrets stay server-side.
model StoreSettings {
  id             String   @id @default("store")
  storeName      String?
  whatsappNumber String?
  phoneNumber    String?
  instagramUsername String?
  addressRu      String?
  addressKk      String?
  deliveryRu     String?
  deliveryKk     String?
  locations      Json?
  updatedAt      DateTime @updatedAt
}

model Operation {
  key         String   @id
  kind        String
  fingerprint String
  result      Json
  createdAt   DateTime @default(now())
}

model OutboxEvent {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  createdAt DateTime @default(now())
  sentAt    DateTime?
}

model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime
}
